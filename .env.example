# --- MIMO-AXON API CONFIGuration ---

# Google Gemini API (Required for OCR & Translation)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud TTS (Optional for High-quality Dubbing)
# Path to your Google Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=docs/proposal/google-service-account.json

# --- SYSTEM SETTINGS ---
# Default Voice for Edge-TTS
DEFAULT_VOICE=vi-VN-HoaiMyNeural
SPEAKING_RATE=+20%
